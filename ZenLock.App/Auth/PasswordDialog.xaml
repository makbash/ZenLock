<Window x:Class="ZenLock.Auth.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZenLock" Height="200" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Topmost="True" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   Text="Bu uygulama kilitli" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubText" Grid.Row="1" FontSize="12" Foreground="#666"
                   Text="Devam etmek için şifre girin." Margin="0,0,0,12"/>

        <PasswordBox x:Name="PwBox" Grid.Row="2" Height="28" FontSize="14"
                     KeyDown="PwBox_KeyDown"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#C0392B" FontSize="12"
                   Margin="0,6,0,0" Visibility="Collapsed"
                   Text="Şifre hatalı, tekrar deneyin."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="İptal" Width="80" Height="28" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Aç" Width="80" Height="28" IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
