<Window x:Class="ZenLock.Ui.SetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre Belirle" Height="260" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="CurrentLabel" Grid.Row="0" Text="Mevcut şifre" Margin="0,0,0,4"/>
        <PasswordBox x:Name="CurrentBox" Grid.Row="1" Height="26" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Yeni şifre" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewBox" Grid.Row="3" Height="26" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Yeni şifre (tekrar)" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmBox" Grid.Row="5" Height="26"/>

        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="#C0392B" FontSize="12"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="İptal" Width="80" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Kaydet" Width="80" Height="28" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
