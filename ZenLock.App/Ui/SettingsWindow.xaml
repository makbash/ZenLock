<Window x:Class="ZenLock.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZenLock — Ayarlar" Height="560" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Şifre bölümü -->
            <GroupBox Header="Master Şifre" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="PwStatus" FontSize="12" Foreground="#666"
                               Text="Şifre durumu" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Şifreyi belirle / değiştir"/>
                        <Button Grid.Column="1" Content="Şifre Belirle" Width="120" Height="28"
                                Click="SetPassword_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Panik tuşu bölümü -->
            <GroupBox Header="Panik Tuşu" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Bu kısayola basınca kilitli uygulamaların pencereleri gizlenir; tekrar basınca şifreyle geri gelir."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox" Grid.Column="0" IsReadOnly="True" Height="28"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#888"
                                   Text="Kutuya tıkla, yeni kısayola bas"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Genel -->
            <GroupBox Header="Genel" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="HideTrayCheck" Content="Tray ikonunu gizle"
                              Click="HideTray_Click"/>
                    <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="22,4,0,0"
                               Text="Gizliyken Ayarlar'a Ctrl+Alt+Shift+S kısayolu ya da 'ZenLock.exe --settings' ile erişilir."/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Kilitli uygulamalar listesi -->
        <GroupBox Grid.Row="1" Header="Kilitli Uygulamalar" Padding="10">
            <ListView x:Name="AppList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Uygulama" Width="160"
                                        DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="Exe" Width="100"
                                        DisplayMemberBinding="{Binding ExeName}"/>
                        <GridViewColumn Header="Yol" Width="200"
                                        DisplayMemberBinding="{Binding FullPath}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Uygulama Ekle..." Width="130" Height="30" Margin="0,0,8,0"
                        Click="AddApp_Click"/>
                <Button Content="Seçiliyi Kaldır" Width="120" Height="30"
                        Click="RemoveApp_Click"/>
            </StackPanel>
            <Button Grid.Column="1" Content="ZenLock'tan Çık" Width="120" Height="30"
                    Click="Exit_Click"/>
        </Grid>

        <TextBlock Grid.Row="3" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Text="Not: Kilit yalnızca şifre belirlendikten sonra etkinleşir. Yönetici hakları gerektirir."/>
    </Grid>
</Window>
